# Scanner image: nmap + adaptive-network-scanner (build from repo root: docker compose build scanner)
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends nmap ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY network_scanner ./network_scanner
RUN pip install --no-cache-dir .

# Raw SYN useful inside the lab; omit if your environment disallows it
USER root
